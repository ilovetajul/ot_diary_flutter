<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#103E43" android:padding="12dp" android:orientation="vertical" android:gravity="center_vertical">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="OT Diary" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_month" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#BCE8DF" android:textSize="12sp" />
    <TextView android:id="@+id/widget_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" />
</LinearLayout>
